:1,"group":"context","label":"D1: cấu trúc cùng hướng","met":true,"oppose":false,"detail":"D1 đang đảo chiều giảm (đã CHoCH, chưa xác nhận), mức bảo vệ 1.15730"},{"id":2,"group":"context","label":"H4: cấu trúc cùng hướng","met":true,"oppose":false,"detail":"H4 xu hướng giảm, mức bảo vệ 1.12926"},{"id":3,"group":"context","label":"D1: màu nến NC cùng phía","met":false,"oppose":true,"detail":"Nến D1 vừa đóng màu xanh dương (M > 0 nhưng đang yếu đi)"},{"id":4,"group":"context","label":"H4: màu nến NC cùng phía","met":false,"oppose":true,"detail":"Nến H4 vừa đóng màu xanh dương (M > 0 nhưng đang yếu đi)"},{"id":5,"group":"zone","label":"Giá chạm một LP còn sống của H4 / D1 / W1","met":true,"oppose":false,"detail":"Đỉnh 1.12657 chạm RLP W1 [1.11437 – 1.14831]"},{"id":6,"group":"zone","label":"LP đó nằm đúng phía hỗ trợ kịch bản","met":true,"oppose":false,"detail":"RLP là vùng hỗ trợ cho SELL"},{"id":7,"group":"zone","label":"Vừa lấy thanh khoản rồi đóng ngược lại","met":false,"oppose":false,"detail":"Không có swing hay cạnh range H4 / D1 / W1 nào vừa bị lấy"},{"id":8,"group":"reaction","label":"Có nến quét (S) trên M15","met":true,"oppose":false,"detail":"Có nến quét S trong 3 nến cuối"},{"id":9,"group":"reaction","label":"Có nến Build trên M15","met":false,"oppose":false,"detail":"Không có nến Build trong 3 nến cuối"},{"id":10,"group":"reaction","label":"Volume cao trào tại đỉnh / đáy","met":false,"oppose":false,"detail":"Volume 3 nến cuối không nổi bật"},{"id":11,"group":"location","label":"Giá ở nửa có lợi của biên độ H4","met":true,"oppose":false,"detail":"Giá ở 59% của biên độ 60 nến H4 [1.10647 – 1.13806] (0% = đáy, 100% = đỉnh)"},{"id":12,"group":"location","label":"Còn từ 40 pip tới mức cản gần nhất","met":true,"oppose":false,"detail":"Mức cản gần nhất: cạnh gần của GLP H4 [1.11061 – 1.11776] 1.11776, cách 74 pip"}],"analysis":[{"title":"Pha thị trường","text":"D1: đang đảo chiều giảm (đã CHoCH, chưa xác nhận), nến NC màu xanh dương (M > 0 nhưng đang yếu đi), mức bảo vệ 1.15730. H4: xu hướng giảm, nến NC màu xanh dương (M > 0 nhưng đang yếu đi), mức bảo vệ 1.12926. Kịch bản SELL tại đỉnh này chỉ được một phần bối cảnh ủng hộ (2/4 tiêu chí bối cảnh)."},{"title":"LP và thanh khoản","text":"Đỉnh 1.12657 chạm RLP W1 [1.11437 – 1.14831], đúng phía hỗ trợ. Không có swing hay cạnh range khung lớn nào vừa bị lấy thanh khoản."},{"title":"Giá phản ứng thế nào","text":"Nhịp đi vào đỉnh dài 86 pip trong 16 nến M15 (4 giờ). Nến tạo đỉnh có râu từ chối chiếm 50% biên độ nến. Trong 3 nến cuối có nến quét S. Thời điểm: phiên London (giờ server GMT+0)."},{"title":"Kết luận khách quan","text":"7/12 tiêu chí sách vở ủng hộ SELL (bối cảnh 2/4, vùng thanh khoản 2/3, phản ứng giá 1/3, vị trí 2/2): tín hiệu lẫn lộn. Con số này là số tiêu chí đạt, không phải xác suất thắng: khoảng 60 giả thuyết đã được kiểm tra trên chính dữ liệu này và không tìm thấy lợi thế ổn định nào từ các tiêu chí trên. Điểm cắt là đúng nến tạo đỉnh, thứ chỉ biết được sau này; ngoài đời bạn không biết đây đã là đỉnh hay chưa."}]}